# کپی کنید به .env و مقادیر واقعی را بعد از خرید سرویس‌ها پر کنید.
# ⚠️ این فایل و فایل .env هرگز نباید وارد گیت شوند (در .gitignore هستند).
# کلیدهای واقعی فقط به‌صورت متغیر محیطی/secret استفاده می‌شوند.

# دیتابیس
DB_PASSWORD=change-me

# نقشه نشان (https://platform.neshan.org — ثبت‌نام رایگان)
NESHAN_API_KEY=

# درگاه پرداخت زرین‌پال (بعد از خرید)
ZARINPAL_MERCHANT_ID=

# سرویس پیامک OTP کاوه‌نگار (بعد از خرید)
KAVENEGAR_API_KEY=
