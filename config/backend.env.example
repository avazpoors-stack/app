# ===== تنظیمات بک‌اند «بدنه» =====
# کپی کنید:  cp backend.env.example backend.env   (فایل backend.env هرگز وارد گیت نمی‌شود)
# همهٔ این‌ها تا فاز آخر اختیاری‌اند؛ بدون آن‌ها سرور در حالت آزمایشی (Mock) کار می‌کند.

# --- دیتابیس ---
# رمز دیتابیس (بعد از خرید سرور، هنگام نصب PostgreSQL می‌سازی)
DB_PASSWORD=

# --- امنیت ---
# کلید مخفی برنامه (در فاز آخر هنگام راه‌اندازی ساخته می‌شود — یک رشتهٔ طولانی تصادفی)
SECRET_KEY=

# --- نقشهٔ نشان (ثبت‌نام رایگان: https://platform.neshan.org) ---
NESHAN_API_KEY=

# --- درگاه پرداخت زرین‌پال (بعد از خرید) ---
ZARINPAL_MERCHANT_ID=

# --- پیامک کد ورود — کاوه‌نگار (بعد از خرید) ---
KAVENEGAR_API_KEY=
