# ===== اطلاعات سرور (برای راه‌اندازی نهایی) =====
# کپی کنید:  cp deploy.env.example deploy.env   (فایل deploy.env هرگز وارد گیت نمی‌شود)
# در فاز آخر، بعد از خرید سرور (VPS) پر می‌شود.

# آدرس سرور (IP یا دامنه)
SERVER_HOST=

# نام کاربری (معمولاً root)
SERVER_USER=root

# دامنهٔ برنامه (مثلاً badane.ir)
DOMAIN=
