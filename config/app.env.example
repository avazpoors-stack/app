# ===== تنظیمات داخل اپ اندروید =====
# کپی کنید:  cp app.env.example app.env   (فایل app.env هرگز وارد گیت نمی‌شود)
# این‌ها هنگام ساخت APK نهایی به اپ داده می‌شوند (فاز آخر).
# بدون آن‌ها اپ کامل کار می‌کند (نقشه به‌صورت جای‌نما، پرداخت «به‌زودی»).

# کلید نقشهٔ نشان (برای نمایش نقشهٔ باشگاه‌ها و فروشگاه‌ها)
NESHAN_API_KEY=

# آدرس سرور (بعد از راه‌اندازی؛ مثل https://api.badane.ir)
# هنگام ساخت APK با --dart-define=BADANE_API_URL=https://api.badane.ir/api/v1 داده می‌شود.
# بدون آن، اپ کاملاً آفلاین کار می‌کند (ورود/همگام‌سازی غیرفعال، حالت مهمان).
BADANE_API_URL=
