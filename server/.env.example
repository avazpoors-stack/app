# ===== نمونهٔ تنظیمات بک‌اند «بدنه» — این فایل را کپی کن و نامش را بگذار backend.env =====
# هیچ‌وقت فایل واقعی (بدون .example) را commit نکن.

# محیط: development | production
APP_ENV=development

# دیتابیس — توسعه: SQLite؛ تولید: PostgreSQL
DATABASE_URL=sqlite:///./badane.db
# DATABASE_URL=postgresql+psycopg://badane:CHANGE_ME@localhost:5432/badane

# ===== امنیت =====
# در production الزامی است (بدون آن سرویس بالا نمی‌آید). از کدوم‌کاراکتر بلند استفاده کن.
# تولید: openssl rand -hex 32
JWT_SECRET=

# طول عمر توکن‌ها
JWT_ACCESS_TTL_MIN=15
JWT_REFRESH_TTL_DAYS=7

# ===== پیامک OTP =====
# تا وقتی کلید کاوه‌نگار نگذاری، حالت Mock است (کد در پاسخ توسعه نمایش داده می‌شود).
# KAVENEGAR_API_KEY=
OTP_TTL_SEC=120
OTP_MAX_ATTEMPTS=5
OTP_REQUEST_PER_MIN=1
OTP_REQUEST_PER_HOUR=5
LOGIN_ATTEMPTS_PER_15MIN=5

# ===== CORS (فقط اگر کلاینت وبی داری؛ اپ اندروید به آن نیاز ندارد) =====
CORS_ORIGINS=

# ===== پشتیبان‌گیری روزانه (اسکریپت scripts/backup.py) =====
BACKUP_DIR=./backups
BACKUP_KEEP=14
